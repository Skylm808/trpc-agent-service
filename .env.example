# Copy this file to .env and replace the placeholder locally. Never commit .env.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
POSTGRES_PASSWORD=local-postgres-password
TRPC_AGENT_GATEWAY_TOKEN_DEMO_HTTP=local-secret
# Admin API credentials: name=token:tenant-list, separated by ';', '*' means all tenants.
# Leave empty to keep the Admin API fail-closed; set a strong deployment secret explicitly.
TRPC_AGENT_ADMIN_TOKENS=
# Fill these only when demo-wecom is enabled in configs/example.yaml.
WECOM_CALLBACK_TOKEN=replace-with-callback-token
WECOM_APP_SECRET=replace-with-application-secret
WECOM_ENCODING_AES_KEY=replace-with-43-character-encoding-aes-key
# Fill these only when demo-feishu is enabled via the Admin API.
FEISHU_VERIFICATION_TOKEN=replace-with-verification-token
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_ENCRYPT_KEY=replace-with-encrypt-key
